---
import { site } from '../config';

interface Props {
  title?: string;
  text?: string;
}

const { title = 'Хочешь научиться дрифту?', text = 'Запишись на тренировку — Дмитрий лично ответит на вопросы и подберёт удобное время.' } = Astro.props;
---

<div class="cta-banner reveal">
  <h2>{title}</h2>
  <p>{text}</p>
  <div class="cta-banner__actions">
    <a class="btn btn--lg" href={site.telegram} target="_blank" rel="noopener">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 2 11 13"></path><path d="M22 2l-7 20-4-9-9-4 20-7z"></path>
      </svg>
      Telegram
    </a>
    <a class="btn btn--lg btn--amber" data-tel href="#">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
      </svg>
      Позвонить
    </a>
    <a class="btn btn--lg btn--ghost" href={site.whatsapp} target="_blank" rel="noopener">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
      </svg>
      WhatsApp
    </a>
  </div>
</div>
