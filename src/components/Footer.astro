---
import { nav, site, contacts, asset } from '../config';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href={asset('/')} class="brand">
          <span class="brand-mark" aria-hidden="true">
            <svg width="30" height="30" viewBox="0 0 32 32" fill="none">
              <path d="M5 5h9l-2.4 8.5H19L16.6 22l9-17h-9l2.4-8.5H8L5 5z" fill="var(--red)" />
            </svg>
          </span>
          <span class="brand-text">
            SEMENIUK
            <span class="brand-sub">Drift School</span>
          </span>
        </a>
        <p>
          Школа дрифта Дмитрия Семенюка — обучение дрифту на трассе СТК «Пилот» в
          Краснодарском крае.
        </p>
      </div>

      <div class="footer-col">
        <h4>Навигация</h4>
        <ul>
          {nav.slice(1).map((item) => (
            <li>
              <a href={asset(item.href)}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Контакты</h4>
        <ul>
          {contacts.map((c) => (
            <li>
              <a href={c.href} rel={c.href.startsWith('http') ? 'noopener' : undefined}>
                {c.label}: {c.value}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {site.name}. Все права защищены.</span>
      <span>{site.addressShort}</span>
    </div>
  </div>
</footer>
