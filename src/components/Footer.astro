---
import { nav, site, contacts, asset } from '../config';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href={asset('/')} class="brand">
          <img src={asset('/images/school-logo.png')} alt="Semeniuk Drift School" />
        </a>
        <p>
          Школа дрифта Дмитрия Семенюка — обучение дрифту на трассе СТК «Пилот» в
          Краснодарском крае.
        </p>
      </div>

      <div class="footer-col">
        <h4>Навигация</h4>
        <ul>
          {nav.slice(1).map((item) => (
            <li>
              <a href={asset(item.href)}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Контакты</h4>
        <ul>
          {contacts.map((c) => (
            <li>
              <a href={c.href} rel={c.href.startsWith('http') ? 'noopener' : undefined} data-tel={c.href === '#'}>
                {c.label}: {c.value}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {site.name}. Все права защищены.</span>
      <span class="dev-copy">
        <a href="https://pixelplus.ru/" target="pixelplus" aria-label="Создание сайта — компания «Пиксель Плюс»">
          <img src={asset('/images/pixelplus-logo.png')} alt="Пиксель Плюс" />
        </a>
        <a href="https://pixelplus.ru/" target="pixelplus">Создание сайта</a> — компания <a href="https://pixelplus.ru/" target="pixelplus">Пиксель Плюс</a>
      </span>
      <span>{site.addressShort}</span>
    </div>
  </div>
</footer>
