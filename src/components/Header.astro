---
import { nav, site, asset } from '../config';
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href={asset('/')} class="brand" aria-label="Semeniuk Drift School — на главную">
      <img src={asset('/images/school-logo.png')} alt="Semeniuk Drift School" />
    </a>

    <nav class="nav" aria-label="Основная навигация">
      {nav.map((item) => {
        const active = item.href === '/' ? pathname === asset('/') : pathname.startsWith(asset(item.href));
        return (
          <a href={asset(item.href)} aria-current={active ? 'page' : undefined}>
            {item.label}
          </a>
        );
      })}
    </nav>

    <a class="btn btn--sm header-cta" data-tel href="#">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
      </svg>
      Позвонить
    </a>

    <button class="nav-toggle" aria-label="Меню" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .brand-mark svg {
    display: block;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }
</style>
