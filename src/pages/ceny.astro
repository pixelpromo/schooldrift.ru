---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import { site, absolute } from '../config';
import { prices, extraPrices } from '../data/content';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'OfferCatalog',
  name: 'Стоимость обучения дрифту',
  itemListElement: prices.map((p, i) => ({
    '@type': 'Offer',
    position: i + 1,
    itemOffered: {
      '@type': 'Service',
      name: p.title,
      description: p.includes.join('. '),
    },
    priceCurrency: 'RUB',
    price: p.price.replace(/\D/g, ''),
    seller: { '@id': `${absolute('/')}#organization` },
    availability: 'https://schema.org/InStock',
  })),
};
---

<BaseLayout
  title="Стоимость обучения дрифту — школа дрифта Дмитрия Семенюка"
  description="Стоимость обучения дрифту: час на автомобиле школы — 45 000 ₽, на вашем автомобиле — от 10 000 ₽, курс из 8 уроков — 640 000 ₽. Трасса СТК «Пилот», Краснодарский край."
  image="/images/drift-e.jpg"
  jsonLd={jsonLd}
>
  <section class="page-head">
    <div class="container">
      <span class="kicker">Стоимость</span>
      <h1>Стоимость обучения дрифту</h1>
      <p class="lead">
        Выберите удобный формат: на полностью подготовленном автомобиле школы или на вашем авто.
        Резина, бензин и аренда площадки уже включены.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-3">
        {prices.map((p) => (
          <div class={`card price-card ${p.featured ? 'price-card--featured' : ''} reveal`}>
            {p.tag && <span class="price-card__tag">{p.tag}</span>}
            <h3>{p.title}</h3>
            <div>
              <div class="price-card__price">{p.price}</div>
              <div class="price-card__unit">{p.unit}</div>
            </div>
            <ul>
              {p.includes.map((inc) => (
                <li>{inc}</li>
              ))}
            </ul>
            <a class="btn btn--sm" href={site.telegram} target="_blank" rel="noopener">Записаться</a>
          </div>
        ))}
      </div>

      <div class="section-head reveal" style="margin-top: clamp(3rem, 6vw, 5rem);">
        <span class="kicker">Дополнительно</span>
        <h2>Аренда трассы и подготовка автомобиля</h2>
      </div>
      <div class="grid-2">
        {extraPrices.map((e) => (
          <div class="card reveal">
            <h3>{e.title}</h3>
            <div class="price-card__price" style="margin-top: 0.6rem;">{e.price}</div>
            <div class="price-card__unit">{e.unit}</div>
          </div>
        ))}
      </div>

      <p class="muted reveal" style="margin-top: 2rem; max-width: 68ch;">
        Точную программу и количество занятий тренер подберёт индивидуально — напишите или
        позвоните, чтобы получить консультацию и выбрать удобное время.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CTABanner title="Запишитесь на тренировку" text="Уточнить детали и записаться на занятие можно по телефону или в мессенджерах — Дмитрий ответит лично." />
    </div>
  </section>
</BaseLayout>
