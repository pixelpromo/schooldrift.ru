---
import BaseLayout from '../layouts/BaseLayout.astro';
import Marquee from '../components/Marquee.astro';
import CTABanner from '../components/CTABanner.astro';
import { site, asset, absolute } from '../config';
import { stats, achievements, methodology, cars, track, students, prices, faq } from '../data/content';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Обучение дрифту в школе Дмитрия Семенюка',
  description: site.description,
  provider: { '@id': `${absolute('/')}#organization` },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'Onsite',
    location: {
      '@type': 'Place',
      name: track.name,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Усть-Лабинск',
        addressRegion: 'Краснодарский край',
        addressCountry: 'RU',
      },
    },
  },
};
---

<BaseLayout
  title="Школа дрифта Дмитрия Семенюка — обучение дрифту в Краснодарском крае"
  description="Обучение дрифту с легендой российского дрифта Дмитрием Семенюком. Дрифт без ручника, гоночные Toyota Mark II, трасса СТК «Пилот» в Усть-Лабинске. Запись по телефону и в Telegram."
  image="/images/drift-g.jpg"
  jsonLd={jsonLd}
>
  <!-- ============================ HERO ============================ -->
  <section class="hero">
    <div class="hero__media">
      <img
        src={asset('/images/drift-g.jpg')}
        alt="Дрифт на гоночной трассе — школа дрифта Дмитрия Семенюка"
        width="1680"
        height="1120"
        fetchpriority="high"
      />
    </div>
    <div class="container">
      <div class="hero__content">
        <h1>Обучение дрифту с <span class="text-grad">Дмитрием Семенюком</span></h1>
        <p class="hero__sub">
          Авторская методика — постановка и перекладки без ручного тормоза. Гоночные Toyota Mark II
          и трасса СТК «Пилот» в Усть-Лабинске. Ученики школы — чемпионы RDS.
        </p>
        <div class="hero__actions">
          <a class="btn btn--lg" href={site.telegram} target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13"></path><path d="M22 2l-7 20-4-9-9-4 20-7z"></path></svg>
            Telegram
          </a>
          <a class="btn btn--lg btn--amber" href={site.whatsapp} target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
            WhatsApp
          </a>
        </div>
      </div>
    </div>
    <div class="hero__accent"></div>
  </section>

  <Marquee />

  <!-- ============================ STATS ============================ -->
  <section class="section">
    <div class="container">
      <div class="stats reveal">
        {stats.map((s) => (
          <div class="stat">
            <div class="stat__value">{s.value}</div>
            <div class="stat__label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================== ABOUT DMITRY ========================= -->
  <section class="section">
    <div class="container split">
      <div class="split__media reveal">
        <img
          src={asset('/images/drift-a.jpg')}
          alt="Дмитрий Семенюк — дрифт без ручника"
          width="1400"
          height="933"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="reveal">
        <span class="kicker">Основатель школы</span>
        <h2>Легенда российского дрифта</h2>
        <p class="muted" style="margin-top: 1rem;">
          Дмитрий Семенюк — основатель RDS (Российской Дрифт Серии), один из трёх российских пилотов
          с лицензией D1GP Японии и участник мирового турнира D1 World Cup. Более 20 лет в дрифте и
          собственная методика, которая выпускает чемпионов.
        </p>
        <ul class="achieve-list">
          {achievements.slice(1, 5).map((a) => (
            <li>{a.href ? <a href={a.href} target="_blank" rel="noopener">{a.text}</a> : a.text}</li>
          ))}
        </ul>
        <div style="margin-top: 1.8rem;">
          <a class="btn btn--ghost" href={asset('/dmitrij-semenyuk/')}>Подробнее о Дмитрии</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================= METHODOLOGY ========================= -->
  <section class="section" style="background: var(--bg-2); border-block: 1px solid var(--line);">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <span class="kicker">Методика</span>
        <h2>Дрифт без ручного тормоза</h2>
        <p>{methodology.intro}</p>
      </div>
      <div class="grid-3">
        {methodology.skills.map((s, i) => (
          <div class="card reveal">
            <div class="card__icon" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
            <h3>{s.split('—')[0].trim()}</h3>
            <p>{s}</p>
          </div>
        ))}
      </div>
      <p class="muted reveal" style="margin-top: 1.8rem; text-align: center;">
        {methodology.advanced}
      </p>
      <div style="text-align: center; margin-top: 1.8rem;" class="reveal">
        <a class="btn" href={asset('/obuchenie/')}>Как проходит обучение</a>
      </div>
    </div>
  </section>

  <!-- =========================== CARS/TRACK ======================= -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">Автопарк и трасса</span>
        <h2>Гоночные Toyota Mark II на СТК «Пилот»</h2>
        <p>
          Тренировки проходят на профессиональной гоночной трассе {track.name} в г. {track.city} —
          рядом с Краснодаром. На территории — {track.amenities.join(', ').toLowerCase()}.
        </p>
      </div>
      <div class="grid-2">
        {cars.map((c, i) => (
          <div class="media-card reveal">
            <img
              src={i === 0 ? asset('/images/drift-b.jpg') : asset('/images/drift-c.jpg')}
              alt={`${c.name} — ${c.power}`}
              width="1400"
              height="933"
              loading="lazy"
              decoding="async"
            />
            <div class="media-card__label">
              <strong>{c.name}</strong>
              <span>{c.power}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================== STUDENTS ========================= -->
  <section class="section" style="background: var(--bg-2); border-block: 1px solid var(--line);">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">Результаты</span>
        <h2>Ученики, которые стали чемпионами</h2>
      </div>
      <div class="grid-3">
        {students.slice(0, 3).map((st, i) => (
          <div class="card student-card reveal">
            <div class="student-card__num">0{i + 1}</div>
            <h3>{st.name}</h3>
            <ul>
              {st.achievements.slice(0, 2).map((a) => (
                <li>{a}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div style="margin-top: 1.8rem;" class="reveal">
        <a class="btn btn--ghost" href={asset('/ucheniki/')}>Все ученики</a>
      </div>
    </div>
  </section>

  <!-- ============================ PRICES ========================== -->
  <section class="section">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <span class="kicker">Стоимость</span>
        <h2>Цены на обучение дрифту</h2>
        <p>На машине школы или на вашем автомобиле — формат под любой уровень подготовки.</p>
      </div>
      <div class="grid-3">
        {prices.map((p) => (
          <div class={`card price-card ${p.featured ? 'price-card--featured' : ''} reveal`}>
            {p.tag && <span class="price-card__tag">{p.tag}</span>}
            <h3>{p.title}</h3>
            <div>
              <div class="price-card__price">{p.price}</div>
              <div class="price-card__unit">{p.unit}</div>
            </div>
            <ul>
              {p.includes.map((inc) => (
                <li>{inc}</li>
              ))}
            </ul>
            <a class="btn btn--sm" href={asset('/ceny/')}>Подробнее</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================= FAQ ============================ -->
  <section class="section" style="background: var(--bg-2); border-block: 1px solid var(--line);">
    <div class="container">
      <div class="section-head reveal">
        <span class="kicker">FAQ</span>
        <h2>Частые вопросы</h2>
      </div>
      <div class="faq-list">
        {faq.slice(0, 4).map((f) => (
          <details class="faq-item reveal">
            <summary>{f.q}</summary>
            <div class="faq-a">{f.a}</div>
          </details>
        ))}
      </div>
      <div style="margin-top: 1.8rem;" class="reveal">
        <a class="btn btn--ghost" href={asset('/faq/')}>Все вопросы</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CTABanner />
    </div>
  </section>
</BaseLayout>

<style>
  .media-card__label {
    position: absolute;
    left: 1.2rem;
    right: 1.2rem;
    bottom: 1.2rem;
    z-index: 2;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .media-card__label strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
  }
  .media-card__label span {
    color: var(--red);
    font-weight: 700;
    font-size: 0.95rem;
  }
</style>
