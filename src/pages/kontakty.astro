---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, contacts, asset, absolute } from '../config';
import { track } from '../data/content';

const mapUrl = 'https://yandex.ru/maps/?text=' + encodeURIComponent('СТК Пилот, Усть-Лабинск');

const items = [
  { label: 'Телефон', value: 'Позвонить', note: 'Дмитрий — запись на уроки', href: '#', icon: 'phone' },
  { label: 'Telegram', value: site.telegramHandle, note: 'Быстрый ответ', href: site.telegram, icon: 'telegram' },
  { label: 'WhatsApp', value: site.whatsappDisplay, note: 'Написать', href: site.whatsapp, icon: 'whatsapp' },
  { label: 'Instagram', value: site.instagramHandle, note: 'Школа в соцсетях', href: site.instagram, icon: 'instagram' },
  { label: 'Email', value: site.email, note: 'Для подробных вопросов', href: `mailto:${site.email}`, icon: 'mail' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'EducationalOrganization'],
  '@id': `${absolute('/')}#organization`,
  name: site.name,
  url: absolute('/'),
  telephone: site.phoneDisplay,
  email: site.email,
  priceRange: '₽₽₽',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'СТК «Пилот»',
    addressLocality: 'Усть-Лабинск',
    addressRegion: 'Краснодарский край',
    addressCountry: 'RU',
  },
  sameAs: [site.telegram, site.instagram],
};
---

<BaseLayout
  title="Контакты школы дрифта — запись на обучение | Краснодарский край"
  description="Запись на обучение дрифту: по телефону, в Telegram @semeniukd или WhatsApp. Трасса СТК «Пилот» в Усть-Лабинске, Краснодарский край."
  image="/images/team-2.jpg"
  jsonLd={jsonLd}
>
  <section class="page-head">
    <div class="container">
      <span class="kicker">Контакты</span>
      <h1>Запись на обучение дрифту</h1>
      <p class="lead">
        Позвоните или напишите — Дмитрий лично ответит на вопросы и подберёт удобное время для
        тренировки.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-3">
        {items.map((it) => (
          <a class="card contact-card reveal" href={it.href} target={it.href.startsWith('http') ? '_blank' : undefined} rel={it.href.startsWith('http') ? 'noopener' : undefined} data-tel={it.href === '#'}>
            <div class="card__icon" aria-hidden="true">
              {it.icon === 'phone' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              )}
              {it.icon === 'telegram' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"></path><path d="M22 2l-7 20-4-9-9-4 20-7z"></path></svg>
              )}
              {it.icon === 'whatsapp' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
              )}
              {it.icon === 'instagram' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
              )}
              {it.icon === 'mail' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              )}
            </div>
            <h3>{it.label}</h3>
            <div class="contact-card__value">{it.value}</div>
            <p>{it.note}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--bg-2); border-block: 1px solid var(--line);">
    <div class="container split">
      <div class="reveal">
        <span class="kicker">Локация</span>
        <h2>Трасса СТК «Пилот»</h2>
        <p style="margin-top: 1rem;">
          Занятия проходят на профессиональной гоночной трассе в г. {track.city}, {track.region} —
          рядом с Краснодаром. На территории трассы есть всё для комфортной поездки:
        </p>
        <ul class="check-list">
          {track.amenities.map((a) => (
            <li>{a}</li>
          ))}
        </ul>
        <div style="margin-top: 1.8rem;">
          <a class="btn btn--ghost" href={mapUrl} target="_blank" rel="noopener">Открыть на карте</a>
        </div>
      </div>
      <div class="split__media reveal">
        <img
          src={asset('/images/team-3.jpg')}
          alt="Трасса СТК «Пилот» — дрифт-тренировки"
          width="1680"
          height="1117"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .contact-card__value {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--text);
    word-break: break-word;
  }
  .contact-card:hover .contact-card__value {
    color: var(--red);
  }
</style>
